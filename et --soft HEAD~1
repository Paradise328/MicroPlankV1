[32m+[m[32m    // 3. 设置从机地址 (Slave ID = 1)[m
[32m+[m[32m    modbus_set_slave(ctx, SLAVE_ID);[m
[32m+[m
[32m+[m[32m    // 4. 建立连接[m
[32m+[m[32m    if (modbus_connect(ctx) == -1) {[m
[32m+[m[32m        LOG(ERROR) << "Connection failed: " << modbus_strerror(errno);[m
[32m+[m[32m        modbus_free(ctx);[m
[32m+[m[32m        ctx = nullptr;[m
[32m+[m[32m        return false;[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    LOG(INFO) << "Pressure Sensor Connected on " << portName;[m
